{
  "manifest_version": 3,
  "name": "Local Manga Translator",
  "version": "0.1.0",
  "description": "Translate manga pages with a local detection/OCR/inpainting service and a local LLM.",
  "permissions": ["storage", "activeTab", "scripting", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Local Manga Translator" },
  "options_page": "options.html"
}
