# Copy this file to .env and fill it in. install.py does the copy for you if .env doesn't exist yet.
# Real environment variables override anything set here. Lines are KEY=value; quotes are optional.
# ${NAME} expands from your environment, so a secret can stay in your shell profile: LLM_API_KEY=${MY_TOKEN}
# Set LJT_ENV_FILE to use a different file.

# --------------------------------------------------------------------------------------------------
# Translation LLM (needed for English output in both the video and manga tools)
# Any OpenAI-compatible server works: TabbyAPI, LM Studio, llama.cpp's llama-server, vLLM, Ollama
# (http://localhost:11434/v1), or a hosted API. This project doesn't install or run the model for you.
# --------------------------------------------------------------------------------------------------

# Base URL up to and including /v1
LLM_BASE_URL=http://localhost:5000/v1

# Model id exactly as the server lists it at <LLM_BASE_URL>/models, e.g. Artemis-31B-v1.2 (see README)
LLM_MODEL=

# API key, sent as "Authorization: Bearer <key>". Leave empty if your server has no auth.
LLM_API_KEY=

# How the tools manage the model:
#   openai   - only send requests; you load the model yourself (works with anything; the default)
#   tabby    - TabbyAPI: use LLM_MODEL if loaded, load it if nothing is loaded (needs an admin key) and unload it
#              afterwards; if a different model is loaded, stop rather than swap it (shared-server friendly)
#   lmstudio - LM Studio on this machine: load LLM_MODEL fully on the GPU with the `lms` CLI if it isn't loaded
#              (the video tool also unloads LM Studio's models before its GPU-heavy steps)
LLM_BACKEND=openai

# tabby only: translate with whatever model is loaded instead of stopping (1 = yes)
LLM_USE_LOADED_MODEL=0
# tabby only, used when the tools load the model themselves: context length and KV-cache quantization
TABBY_LOAD_CTX=16384
TABBY_CACHE_MODE=8,8
# lmstudio only: context length when loading
LMSTUDIO_LOAD_CTX=16384

# Optional. Sent as "reasoning_effort". "none" turns thinking off on servers that support it (LM Studio and some
# hosted APIs), which makes thinking models much faster. Leave empty if your server rejects the field.
LLM_REASONING_EFFORT=

# --------------------------------------------------------------------------------------------------
# Video: existing subtitles first (optional, see README "Existing subtitles")
# With an API key set, the video tool looks for subtitles on OpenSubtitles.com before running speech recognition,
# syncs them to the file's audio and skips Whisper and the LLM when the sync checks out. Without a key it goes
# straight to speech recognition. --no-opensubtitles turns it off for one run.
# --------------------------------------------------------------------------------------------------

# Your own API key: opensubtitles.com -> profile -> API consumers -> create a consumer.
OPENSUBTITLES_API_KEY=
# Optional account login. Without one, OpenSubtitles allows 5 downloads per IP per day; a free account gets 20.
# Only sent to the /login endpoint. Keep the password out of this file with ${VAR}, e.g. OPENSUBTITLES_PASSWORD=${OS_PASS}
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
# Language of the default subtitle track to look for (OpenSubtitles codes: en, fr, pt-br, zh-cn...). The fallback
# (speech recognition + LLM) always writes English. Same as --subs-lang.
SUBS_LANG=en
# Downloads to try per language before falling back (each one counts against the daily quota)
# OPENSUBTITLES_MAX_TRIES=3
# Sync check: share of subtitle time that has to fall on detected speech, and how much better than the same
# subtitles shifted by a few seconds it has to be
# OPENSUBTITLES_MIN_OVERLAP=0.40
# OPENSUBTITLES_MIN_MARGIN=0.08

# --------------------------------------------------------------------------------------------------
# Video: decensoring with Jasna (optional, see README)
# --------------------------------------------------------------------------------------------------

# Full path to jasna.exe (Windows) or the jasna binary (Linux). Leave empty to never decensor: the video tool
# then subtitles videos as they are (same as passing --skip-decensor).
JASNA_EXE=
# Extra Jasna CLI arguments. Default = the GUI's "LTX, Good quality". Run `jasna --help` for all options.
# Long, heavily mosaicked videos: add --ltx-auto-split 30 (big mosaics get LTX, small ones the faster BasicVSR++).
# No LTX model or not enough VRAM: use --restoration-model-name basicvsrpp
JASNA_ARGS=--restoration-model-name ltx-4step

# --------------------------------------------------------------------------------------------------
# Video: speech recognition (optional overrides)
# --------------------------------------------------------------------------------------------------
# WHISPER_MODEL=large-v3
# WHISPER_COMPUTE=float16

# --------------------------------------------------------------------------------------------------
# Manga: local translation service used by the Chrome extension and the archive tool (optional overrides)
# --------------------------------------------------------------------------------------------------
# The service always binds 127.0.0.1; only the port is configurable.
# MANGA_PORT=8765
# Pin the service to one extension id (shown on chrome://extensions after loading it). Empty = any extension.
# MANGA_EXTENSION_ID=
# Relative paths below are relative to the manga folder.
# MANGA_CACHE_DIR=cache
# MANGA_MODEL_DIR=models
# MANGA_TOKEN_FILE=service/token.txt
# MANGA_MAX_UPLOAD_MB=40
# MANGA_MAX_PIXELS=40000000
